# ─── ClassVisionAI Configuration ─────────────────────────────────────────────
# Copy this to .env and adjust values for your environment

# ── Server ──────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ── Camera ──────────────────────────────────────────────────────────────────────
CAMERA_INDEX=0               # 0 = built-in webcam, 1 = external USB cam
FRAME_WIDTH=1280
FRAME_HEIGHT=720
TARGET_FPS=15                # Processing FPS (lower = less CPU on M-chips)

# ── Model Settings ──────────────────────────────────────────────────────────────
YOLO_MODEL=yolov8n.pt        # nano=fastest, small=balanced, medium=most accurate
YOLO_CONFIDENCE=0.5
DEVICE=auto                  # auto=pick best (mps on Mac, cuda on NVIDIA, else cpu)

# ── Attention Scoring ───────────────────────────────────────────────────────────
HEAD_POSE_WEIGHT=0.45
BEHAVIOUR_WEIGHT=0.35
EMOTION_WEIGHT=0.20
ATTENTION_WINDOW_SECONDS=60
SCORE_UPDATE_INTERVAL=10

# ── Head Pose Thresholds (degrees) ──────────────────────────────────────────────
YAW_ATTENTION_THRESHOLD=25
PITCH_ATTENTION_THRESHOLD=20

# ── Alert Thresholds ────────────────────────────────────────────────────────────
LOW_ATTENTION_THRESHOLD=40   # class avg below this triggers alert
ALERT_COOLDOWN_SECONDS=60

# ── Database ─────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./classvision.db

# ── Emotion Analysis ────────────────────────────────────────────────────────────
EMOTION_BACKEND=opencv        # opencv=fast, retinaface=accurate (needs GPU)
EMOTION_UPDATE_INTERVAL=3     # analyze emotion every N seconds per student

# ── Privacy ─────────────────────────────────────────────────────────────────────
STORE_RAW_FRAMES=false        # NEVER store raw frames — privacy first
BLUR_FACES_IN_STREAM=false    # blur faces in live stream preview
